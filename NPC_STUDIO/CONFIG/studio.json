{
  "voice_profile": "NPC_VOICE_V1",
  "python": "VOICE_ENGINE/.venv/bin/python",
  "render": {
    "browser": "/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
    "gl": "swangle",
    "preview_quality": 0.5,
    "final": { "codec": "h264", "crf": 14, "x264_preset": "slow", "pix_fmt": "yuv420p" },
    "audio": { "codec": "aac", "bitrate": "320k", "sample_rate": 48000, "channels": 2, "target_lufs": -14 }
  },
  "env_overrides": {
    "NPC_BROWSER": "path to a Chrome/Chromium headless shell",
    "NPC_GL": "angle | swangle | egl (use 'angle' or 'egl' on a GPU machine)",
    "NPC_DEVICE": "cpu | cuda | mps for Chatterbox"
  }
}
